{
 "version": "16.22.1",
 "source": "wiki.leagueoflegends.com/en-us/Ability_resource (internal index table) + 项目 data/champions-16.22.1.json 的 partype",
 "definition": "资源条 = 游戏主视角/侧栏头像血条正下方那一条长条（wiki 称 primary resource, 'the resource line under the current health line'）。血条底部的分格 pips / 图标属 secondary resource，不计入。",
 "classes": {
  "A": "固定单色条，颜色与含义恒定（145 法力 + 6 能量）",
  "B": "独立条但颜色/形态随状态变化（11 人）",
  "C": "条长表示倒计时或状态剩余，不是资源量（5 人）——必须按英雄+状态门控，条不存在 ≠ 0%",
  "D": "完全无资源条（6 人）"
 },
 "pixelReading": {
  "judgement": "filled = (saturation > 0.35) or (luminance > 170 and saturation <= 0.35)",
  "note": "前分支覆盖所有彩色条；后分支专治白色/浅色条（剑意/豪意/护盾）。先裁掉左右各 2px 避免外框(111,109,111)被误判；填充率取最右侧填充像素位置，不能取连续段长度（刻度线会挖洞）。",
  "precision": "1px ≈ 1.96%（满宽 51px @2560x1440）",
  "shieldCaveat": "Mordekaiser 的潜在护盾是独立资源条（wiki Ability resource index 3 shield），不是血条白段；W 激活后的真实护盾才以 #C0C0C0 叠在血条右端，必须单独输出 shieldPx 且不并入 HP —— 真实素材尚未验证"
 },
 "unverified": [
  "Rumble 白/黄/橙三段的确切像素色值与分界点（wiki 全文无颜色原文，只能靠像素 dominantColor 实测）",
  "Gnar / RekSai / Renekton / Shyvana / Tryndamere 的条颜色（wiki 无颜色原文，此前 note 里的颜色断言已删）",
  "Sett 豪意 / Mordekaiser 护盾 / Kled 勇气 / Briar 狂怒 / Belveth 条的像素颜色（wiki 无原文）",
  "Belveth 非真实形态下条是否绘制（wiki 只说 True Form 剩余时间显示在资源条）",
  "Aatrox 非 R 状态的条颜色",
  "Ambessa 专属 200 上限（只有 Energy 通则，无她的专属原文）",
  "Vladimir 非充能状态条是否绘制",
  "Aatrox / Yone / Briar / Belveth 的条在条槽不存在时的确切位置（可能不绘制而非空条）"
 ],
